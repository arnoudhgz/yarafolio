# --- Dashboard Configuration ---
# You can customize the port the dashboard runs on. Defaults to 8742.
# PORT=8742

# --- Security Settings ---
# eToro API Keys
# You can generate these keys at: https://www.etoro.com/settings/trade
# 🛡️ SECURITY RECOMMENDATION: Always create your API keys in "Read-Only" mode! 
# YaraFolio only needs to read your portfolio; it never places trades on your behalf.

# Your eToro API Key (Public key) - This is global for your account and does not change per IP.
ETORO_API_KEY=your_actual_api_key_here

# Your eToro User Key (Private key)
# Recommendation: Create a separate User key for each IP address you use (e.g., Home, Office).
# Use a suffix (like "_HOME" or "_OFFICE") to identify them, which allows you to switch locations in the dashboard.
ETORO_USER_KEY_HOME=your_actual_user_key_here
ETORO_USER_KEY_OFFICE=your_actual_user_key_here

# Set to 1 to load advice-log.sample.json instead of real data
DEMO_MODE=0

# Auto-backup of data files to the private repo. 1 = on (default), 0 = off.
STOCKS_AUTOSYNC=1

# If you want to automatically backup your private data to a separate Github Repo, add the SSH URL here.
# Example: PRIVATE_DATA_REPO=git@github.com:yourusername/my-private-trading-data.git
PRIVATE_DATA_REPO=
